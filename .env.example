APP_NAME="Tenun Ikat Palugada Bandar"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=id

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tenun_palugada
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public

MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# Akun admin untuk pengembangan lokal
ADMIN_EMAIL=admin@palugadabandar.id
ADMIN_PASSWORD=PalugadaAdmin123!

# Integrasi Kurir dan Ongkir Otomatis (RajaOngkir / Komerce)
# API key layanan RajaOngkir atau Komerce (dikosongkan, jangan mengisi kunci rahasia ke repositori)
ONGKIR_API_KEY=
# URL basis endpoint API ongkir
ONGKIR_BASE_URL=https://rajaongkir.komerce.id/api/v1
# ID lokasi asal toko/pengiriman (kota atau subdistrict, kosongkan jika belum ditentukan)
ONGKIR_ASAL_ID=
# Daftar kode kurir aktif dipisahkan koma (contoh: jne,jnt,sicepat)
ONGKIR_KURIR=jne,jnt,sicepat
# Berat default per produk dalam satuan gram jika belum diatur
ONGKIR_BERAT_DEFAULT_GRAM=500
# Durasi cache tarif ongkir dalam menit (1440 = 24 jam)
ONGKIR_CACHE_ONGKIR_MENIT=1440
# Durasi cache data tujuan dalam menit (10080 = 7 hari)
ONGKIR_CACHE_TUJUAN_MENIT=10080
# Batas waktu timeout permintaan HTTP ke API kurir (dalam detik)
ONGKIR_TIMEOUT_DETIK=10
# Label penanda alamat pengiriman jika pembeli memilih ambil di tempat
ONGKIR_LABEL_AMBIL="Ambil di tempat (Palugada Bandar)"

